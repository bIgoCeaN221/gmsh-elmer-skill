! ══════════════════════════════════════════════════════════════════════════════
!  Rotating PM — example snapshot at 0°  (M along +X)
!  M = (955000.0, 0.0, 0.0) A/m    5 Hz (300 RPM)  ω = 31.4159 rad/s
!  Generate the full set of 36 angles with:  python rotate_scan.py
! ══════════════════════════════════════════════════════════════════════════════
!
!  Body/Boundary numbering (after ElmerGrid renumber):
!    Body 1 = magnet,  Body 2 = air_rotating,  Body 3 = air_stationary
!    BC 1 = far_field,  BC 2 = mag_top,  BC 3 = mag_bot
!    BC 4 = mag_side,   BC 5 = sliding_rotor,  BC 6 = sliding_stator
!
!  Usage:
!    1.  python magnet_mesh.py
!    2.  ElmerGrid 14 2 mesh.msh -out mesh -autoclean
!    3.  cd mesh && cp ../case_rotate.sif .
!    4.  ElmerSolver case_rotate.sif
!    5.  python ../rotate_scan.py   (to generate all 36 angles)
!    6.  python ../create_pvd.py    (to create ParaView animation)
! ══════════════════════════════════════════════════════════════════════════════

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "."
  Include Path ""
  Results Directory "results_angle_000"
End

Simulation
  Max Output Level = 5
  Coordinate System = Cartesian 3D
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output File = "case_angle_000.result"
  Post File = "case_angle_000.vtu"
End

Constants
  Permeability of Vacuum = 1.2566370614359173e-06
  Permittivity of Vacuum = 8.854187817e-12
End

Solver 1
  Equation = "Magnetic AV"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Exec Solver = Always
  Stabilize = True
  Optimize Bandwidth = True

  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStabl
  Linear System Max Iterations = 2000
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0

  Steady State Convergence Tolerance = 1.0e-6
End

Solver 2
  Equation = "Magnetic Field Calc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = AV
  Exec Solver = Always

  Calculate Magnetic Field Strength = True
  Calculate Magnetic Flux Density = True
  Calculate Magnetic Vector Potential = True
  Calculate Nodal Fields = True
  Calculate Current Density = False
  Calculate Joule Heating = False
  Calculate Nodal Forces = False

  Linear System Solver = Iterative
  Linear System Iterative Method = CG
  Linear System Max Iterations = 1000
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
  Steady State Convergence Tolerance = 1.0e-6
End

Solver 3
  Equation = "Result Output"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Exec Solver = After Simulation

  Output File Name = "case_angle_000"
  Output Format = "Vtu"
  Vtu Format = True
  Binary Output = True
  Discontinuous Bodies = True
  Save Geometry IDs = True
End

Equation 1
  Name = "Magnetics"
  Use Piola Transform = Logical True
  Active Solvers(2) = 1 2
End

Material 1
  Name = "NdFeB_N35"
  Relative Permeability = 1.05
  Magnetization 1 = 955000.0
  Magnetization 2 = 0.0
  Magnetization 3 = 0.0
End

Material 2
  Name = "Air"
  Relative Permeability = 1.0
End

Material 3
  Name = "Air"
  Relative Permeability = 1.0
End

Body 1
  Target Bodies(1) = 1
  Name = "Magnet"
  Equation = 1
  Material = 1
  Body Force = 1
End

Body 2
  Target Bodies(1) = 2
  Name = "AirRotating"
  Equation = 1
  Material = 2
End

Body 3
  Target Bodies(1) = 3
  Name = "AirStationary"
  Equation = 1
  Material = 3
End

Body Force 1
  Name = "MagnetizationForce"
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Name = "FarField"
  AV {e} = Real 0
End
